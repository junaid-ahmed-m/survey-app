// Prisma schema for the QR -> Survey -> Coupon platform.
// Enum-like columns are plain strings and survey questions are stored as a JSON
// string so the schema stays portable across database providers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Admin portal users.
model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String?
  passwordHash String
  /// FK-less reference to Role.name
  role         String    @default("VIEWER")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  /// Tokens issued before this moment are rejected, so a password change or
  /// reset immediately invalidates any session that was already open.
  passwordChangedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([role])
}

/// A named bundle of permission strings - see PERMISSIONS in src/common/constants.ts.
model Role {
  name        String   @id
  description String?
  /// JSON encoded array of permission keys
  permissions String   @default("[]")
  /// System roles ship with the platform and cannot be deleted
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Native (built-in) survey definitions.
model Survey {
  id          String   @id @default(uuid())
  title       String
  description String?
  /// JSON encoded array of questions - see SurveyQuestion in src/surveys/survey.types.ts
  questions   String   @default("[]")
  isActive    Boolean  @default(true)

  // --- response forwarding (see src/events) -------------------------------
  /// NONE | WEBHOOK | RUDDERSTACK
  forwardTarget          String  @default("NONE")
  /// Webhook endpoint or RudderStack data plane URL.
  forwardUrl             String?
  /// AES-256-GCM. Webhook signing secret or RudderStack write key.
  forwardSecretEncrypted String?
  forwardEventName       String  @default("Survey Completed")
  /// false = keep no answers or e-mail in this system; the event is the record.
  retainResponses        Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Transactional outbox for outbound analytics events. A row is written in the
/// same transaction as the survey response, so a delivery can never be lost -
/// the dispatcher retries with backoff until the destination acknowledges it.
model EventDelivery {
  id              String    @id @default(uuid())
  eventName       String
  /// WEBHOOK | RUDDERSTACK
  target          String
  endpoint        String
  /// Snapshot of the destination credential at enqueue time (AES-256-GCM).
  secretEncrypted String?
  /// One delivery per redeemed code - also makes replays idempotent. Null for tests.
  codeId          String?   @unique
  batchId         String?
  surveyRef       String?
  /// JSON body to POST. PII free by construction.
  payload         String
  /// PENDING | DELIVERING | DELIVERED | FAILED
  status          String    @default("PENDING")
  attempts        Int       @default(0)
  maxAttempts     Int       @default(12)
  nextAttemptAt   DateTime  @default(now())
  /// Set while a worker holds the row; stale locks are reclaimed after 5 minutes.
  lockedAt        DateTime?
  lastError       String?
  lastStatusCode  Int?
  deliveredAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /// Drives the dispatcher's claim query.
  @@index([status, nextAttemptAt])
  /// Admin listing is ordered newest first.
  @@index([createdAt])
}

/// A code-generation request. Every code inherits its survey + coupon configuration.
model Batch {
  id          String    @id @default(uuid())
  name        String
  description String?
  /// Product identifier this batch of codes is printed on.
  sku         String?
  /// NATIVE | CONTENTFUL | THIRD_PARTY
  surveyType  String
  /// Native Survey.id or Contentful entry id
  surveyId    String?
  /// Third party survey url
  surveyUrl   String?
  /// FK-less reference to CouponType.code
  couponType  String
  prefix      String?
  charset     String
  /// Length of the random body (prefix + checksum char are added on top)
  codeLength  Int
  quantity    Int
  /// DRAFT | ACTIVE | PAUSED | ARCHIVED
  status      String    @default("ACTIVE")
  expiresAt   DateTime?

  // --- code generation ----------------------------------------------------
  /// Batches above the inline threshold are produced by a background worker.
  /// PENDING | RUNNING | COMPLETE | FAILED
  generationStatus      String    @default("COMPLETE")
  /// Codes written so far - drives the progress bar.
  generatedCount        Int       @default(0)
  /// Consecutive failed slices; the batch gives up after a few.
  generationAttempts    Int       @default(0)
  generationError       String?
  /// Held while a worker is producing a slice; stale locks are reclaimed.
  generationLockedAt    DateTime?
  generationStartedAt   DateTime?
  generationCompletedAt DateTime?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  codes Code[]

  @@index([status])
  @@index([sku])
  /// Drives the generation worker's claim query.
  @@index([generationStatus, createdAt])
}

/// Generated codes. The clear-text code is NEVER stored:
///  - codeHash      : deterministic HMAC used for lookups / uniqueness
///  - codeEncrypted : AES-256-GCM ciphertext, decrypted only for admin export / verify
model Code {
  id               String    @id @default(uuid())
  batchId          String
  codeHash         String    @unique
  codeEncrypted    String
  codeMasked       String
  /// UNUSED | USED | DISABLED - a code flips to USED as soon as the survey is shown
  status           String    @default("UNUSED")
  sessionToken     String?   @unique
  sessionExpiresAt DateTime?
  scanCount        Int       @default(0)
  lastScanAt       DateTime?
  usedAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  batch    Batch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  coupon   Coupon?
  response SurveyResponse?

  @@index([batchId, status])
  @@index([status])
  /// Stable ordering for the code listing and the CSV export. `createdAt` cannot
  /// be used: a bulk insert stamps every row in the batch with the same value,
  /// which makes keyset pagination ambiguous.
  @@index([batchId, id])
  /// The cleanup cron sweeps expired sessions every minute - without this it
  /// would scan the whole table.
  @@index([sessionExpiresAt])
}

/// Catalogue of coupon types (the "couponType" referenced by a batch).
model CouponType {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  value       String?
  /// Dashboard raises a low-stock alert at or below this many AVAILABLE coupons.
  lowStockThreshold Int  @default(10)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  coupons Coupon[]
}

/// Coupon inventory. One coupon is reserved up-front, before the survey is shown.
model Coupon {
  id                  String    @id @default(uuid())
  couponTypeCode      String
  couponCodeEncrypted String
  couponCodeHash      String    @unique
  value               String?
  /// AVAILABLE | RESERVED | ISSUED | EXPIRED
  status              String    @default("AVAILABLE")
  codeId              String?   @unique
  reservedUntil       DateTime?
  issuedToEmail       String?
  issuedAt            DateTime?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  couponType CouponType @relation(fields: [couponTypeCode], references: [code], onDelete: Cascade)
  code       Code?      @relation(fields: [codeId], references: [id], onDelete: SetNull)

  /// Queue-pop order for reserveForCode: the index supplies the ORDER BY so the
  /// scan stops at the first unlocked row instead of sorting the whole pool.
  @@index([couponTypeCode, status, createdAt])
  @@index([couponTypeCode, status])
  @@index([status])
  /// Cleanup cron: expired reservations and expired stock.
  @@index([status, reservedUntil])
  @@index([status, expiresAt])
}

/// Stored survey answers (native surveys store the full payload, external ones a receipt).
model SurveyResponse {
  id          String   @id @default(uuid())
  codeId      String   @unique
  batchId     String
  surveyType  String
  surveyRef   String?
  /// JSON encoded answers
  answers     String   @default("{}")
  email       String?
  completedAt DateTime @default(now())

  code Code @relation(fields: [codeId], references: [id], onDelete: Cascade)

  @@index([batchId, completedAt])
  /// Unfiltered response feed is ordered newest first.
  @@index([completedAt])
}

/// Lightweight audit trail for admin + redeem activity.
model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actorId   String?
  entity    String?
  entityId  String?
  ip        String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
  /// The dashboard reads the newest entries without an action filter.
  @@index([createdAt])
  @@index([entityId])
}
