# ---------- Core ----------
NODE_ENV=development
PORT=3000
# Public URL of the React app (used to build QR target URLs + e-mail links)
PUBLIC_APP_URL=http://localhost:5173
# Comma separated CORS origins
CORS_ORIGINS=http://localhost:5173

# ---------- Database ----------
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/qr_rewards?schema=public"

# ---------- Security ----------
# 32-byte key, hex (64 chars) or base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CODE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Pepper used for the deterministic lookup hash of a code
CODE_HASH_SECRET=change-me-code-hash-secret
# Secret used to derive the anti-guessing checksum character of every code
CODE_CHECKSUM_SECRET=change-me-code-checksum-secret

JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=8h

# ---------- Redeem session ----------
REDEEM_SESSION_TTL_MINUTES=30

# ---------- Rate limiting ----------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=60
REDEEM_RATE_LIMIT_TTL_SECONDS=60
REDEEM_RATE_LIMIT_MAX=10

# ---------- Seed admin ----------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345

# ---------- Contentful ----------
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_ACCESS_TOKEN=

# ---------- Mail (leave SMTP_HOST empty to log e-mails to the console) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Rewards <no-reply@example.com>"
